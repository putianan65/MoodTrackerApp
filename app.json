{
  "expo": {
    "name": "MoodTrackerApp",
    "slug": "MoodTrackerApp",
    "description": "A React Native mood tracking app for daily mood logging, activity tracking, history review, and weekly visual summaries.",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "icon": "./assets/icon_padded.png",

    "splash": {
      "image": "./assets/splash-icon_padded.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },

    "android": {
      "package": "com.moodtracker26.MoodTrackerApp",
      "versionCode": 6,
      "icon": "./assets/icon_padded.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground-moodtracker_padded.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },

    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "086738b8-6e79-48ca-9240-d965b10aeb7d"
      }
    }
  }
}
